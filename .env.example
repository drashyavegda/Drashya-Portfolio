# ============================================================================
# Drashya Vegda Portfolio — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local (it is gitignored).
# ============================================================================

# ---- Public site URL (used for canonical URLs, sitemap, Open Graph) --------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Admin authentication (LOCAL/DEMO mode) --------------------------------
# Used when Supabase is NOT configured. Server-side only — never exposed
# to the browser. Login at /admin with these credentials.
ADMIN_EMAIL=drashyavegda@example.com
ADMIN_PASSWORD=drashya@123
# Optional: secret used to sign admin session cookies (recommended).
AUTH_SECRET=Drashya_Portfolio_Auth_2026!K9v#R7x@P2m$L8qW5zN

# ---- Supabase (RECOMMENDED for production persistence) ---------------------
# Create a project at https://supabase.com, run supabase/schema.sql,
# then create the admin user under Authentication -> Users.
NEXT_PUBLIC_SUPABASE_URL=https://wjxtziyhidilcyqmyqzz.supabase.co/rest/v1/
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_4pnGmTgRTsagi0PkxfGRIw_dkBlkTXa
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here

# ---- AI portfolio assistant (optional) -------------------------------------
# Without a key, the built-in verified-knowledge engine answers (no invention).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---- Contact form email delivery (optional) --------------------------------
# Without Resend, messages are still saved to the private admin inbox.
RESEND_API_KEY=
RESEND_FROM_EMAIL=portfolio@yourdomain.com

# ---- GitHub section (optional) ---------------------------------------------
# A personal access token raises the public API rate limit (classic token,
# no scopes needed). Without it the public API + caching is used.
GITHUB_PERSONAL_TOKEN=
GITHUB_USERNAME=drashyavegda
